---
import BaseLayout from '../layouts/BaseLayout.astro';
import HolidayHero from '../components/sections/HolidayHero.astro';
import HolidayGallery from '../components/sections/HolidayGallery.astro';
import HolidayWhatsIncluded from '../components/sections/HolidayWhatsIncluded.astro';
import HolidayFAQ from '../components/sections/HolidayFAQ.astro';
import CTASection from '../components/sections/CTASection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
---

<BaseLayout
  title="Christmas Light Installation in Vancouver, WA"
  description="Professional Christmas light installation in Vancouver, WA and southwest Washington. Commercial-grade LED lights, non-damaging clips, installation and January removal included. Book early - the season fills up."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Christmas Light Installation", url: "/holiday" }
  ]}
  logo="/eversteadlogoholiday.svg"
>
  <HolidayHero />
  <HolidayGallery />
  <HolidayWhatsIncluded />
  <TestimonialsSection />
  <HolidayFAQ />
  <CTASection />
</BaseLayout>
