---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import aboutHeroImg from '../assets/images/about-hero.jpg';
import aboutMissionImg from '../assets/images/about-mission.jpg';
import aboutVisionImg from '../assets/images/about-vision.jpg';

const missionPoints = [
  {
    title: 'Better Roofs:',
    description: 'From free inspections, claim assistance, Roof replacements and home upgrades.',
  },
  {
    title: 'Expert Engineers:',
    description: 'Our experienced, knowledgeable team is here to guide you through every step of the process.',
  },
  {
    title: 'Quality Materials:',
    description: 'We understand the importance of protecting your family and investment, and we treat with care.',
  },
];
---

<BaseLayout title="About Us" description="Learn about Everstead Roofing - a local roofing company serving SW Washington and the greater Portland metro area with over 9 years of experience.">

  <!-- Hero Section -->
  <section class="about-hero">
    <div class="container about-hero__inner">
      <div class="about-hero__content animate-on-scroll slide-right">
        <h1 class="about-hero__title">Everstead<br>Story</h1>
        <p class="about-hero__text">
          We are a local roofing company servicing SW Washington and the greater Portland metro area. With over 9 years of experience, we bring value to the customer and value the local relationships that we have worked hard to build in the community.
        </p>
      </div>
      <div class="about-hero__image animate-on-scroll slide-left">
        <Image src={aboutHeroImg} alt="Aerial view of residential roof installation in Vancouver WA" width={600} height={600} quality={80} format="webp" />
        <div class="about-hero__badge animate-on-scroll scale-in">
          <span class="about-hero__badge-number">9+</span>
          <span class="about-hero__badge-text">Years of<br>Experience</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Panorama with Pillars -->
  <section class="about-panorama-section">
    <div class="about-panorama">
      <Image src={aboutVisionImg} alt="Panoramic view of rooftops in Southwest Washington neighborhood" width={1920} height={600} quality={80} format="webp" />
      <div class="about-panorama__fade"></div>
    </div>
    <div class="container pillars__wrapper">
      <div class="pillars__grid stagger-children">
        <div class="pillars__card animate-on-scroll fade-up">
          <div class="pillars__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
              <path d="M12 2v4M12 18v4"></path>
            </svg>
          </div>
          <span class="pillars__label">Our Mission</span>
        </div>
        <div class="pillars__card animate-on-scroll fade-up">
          <div class="pillars__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 5v-2M12 21v-2M5 12H3M21 12h-2"></path>
            </svg>
          </div>
          <span class="pillars__label">Our Vision</span>
        </div>
        <div class="pillars__card animate-on-scroll fade-up">
          <div class="pillars__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <span class="pillars__label">Trusted Services</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Details Section -->
  <section class="mission section">
    <div class="container mission__inner">
      <div class="mission__image animate-on-scroll slide-right">
        <Image src={aboutMissionImg} alt="New home construction with Everstead Roofing installation" width={600} height={500} quality={80} format="webp" />
      </div>
      <div class="mission__content animate-on-scroll slide-left">
        <h2 class="mission__title">We are on a mission.</h2>
        <p class="mission__text">
          We have been installing and replacing for over 9 years and we are proud to say we are experts in this field. We have a team of skilled & qualified members.
        </p>
        <ul class="mission__list stagger-children">
          {missionPoints.map((point) => (
            <li class="mission__item animate-on-scroll fade-up">
              <svg class="mission__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <div>
                <strong>{point.title}</strong> {point.description}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* About Hero */
  .about-hero {
    background-color: var(--color-white);
    padding: calc(var(--header-height) + var(--space-16)) 0 var(--space-16);
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: var(--space-12);
    align-items: center;
  }

  .about-hero__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.05;
    margin-bottom: var(--space-6);
  }

  .about-hero__text {
    font-size: 1.0625rem;
    color: #5a5a50;
    line-height: 1.7;
    max-width: 540px;
  }

  .about-hero__image {
    position: relative;
  }

  .about-hero__image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .about-hero__badge {
    position: absolute;
    bottom: -30px;
    left: -20px;
    background-color: #e5e5db;
    color: var(--color-navy);
    padding: var(--space-6) var(--space-10);
    border-radius: var(--radius-lg);
    border: 4px solid var(--color-primary);
    text-align: center;
    min-width: 180px;
  }

  .about-hero__badge-number {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .about-hero__badge-text {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Panorama with Pillars */
  .about-panorama-section {
    position: relative;
    margin-top: var(--space-16);
  }

  .about-panorama {
    position: relative;
    width: 100%;
  }

  .about-panorama img {
    width: 100%;
    height: 700px;
    object-fit: cover;
    object-position: center top;
  }

  .about-panorama__fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 280px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.7), white);
    pointer-events: none;
  }

  .pillars__wrapper {
    position: relative;
    margin-top: -180px;
    padding-bottom: var(--space-12);
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .pillars__card {
    background-color: #e5e5db;
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    min-height: 180px;
  }

  .pillars__icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .pillars__label {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.2;
  }

  /* Mission Section */
  .mission {
    background-color: var(--color-navy);
    padding: var(--space-20) 0;
  }

  .mission__inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-16);
    align-items: center;
  }

  .mission__image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 4px solid rgba(255, 255, 255, 0.1);
  }

  .mission__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .mission__text {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }

  .mission__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mission__item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .mission__check {
    flex-shrink: 0;
    color: var(--color-primary);
    margin-top: 4px;
  }

  .mission__item div {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
  }

  .mission__item strong {
    color: var(--color-white);
    font-weight: 700;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .about-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .about-hero__title {
      font-size: 3.5rem;
    }

    .pillars__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .pillars__wrapper {
      margin-top: -80px;
    }

    .about-panorama img {
      height: 400px;
    }

    .mission__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .mission__title {
      font-size: 2.75rem;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: calc(var(--header-height) + var(--space-10)) 0 var(--space-12);
    }

    .about-hero__title {
      font-size: 2.75rem;
    }

    .about-hero__image img {
      height: 350px;
    }

    .about-hero__badge {
      left: 0;
    }

    .about-panorama-section {
      margin-top: var(--space-12);
    }

    .about-panorama img {
      height: 350px;
    }

    .pillars__wrapper {
      margin-top: -60px;
    }

    .pillars__card {
      padding: var(--space-6) var(--space-5);
    }

    .pillars__label {
      font-size: 1.25rem;
    }

    .mission__image img {
      height: 350px;
    }

    .mission__title {
      font-size: 2.25rem;
    }

    .pillars__icon {
      width: 50px;
      height: 50px;
    }

    .pillars__icon svg {
      width: 24px;
      height: 24px;
    }

    .pillars__label {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .about-hero__title {
      font-size: 2.25rem;
    }

    .about-hero__image img {
      height: 300px;
    }

    .about-hero__badge {
      padding: var(--space-5) var(--space-8);
      min-width: 140px;
      bottom: -25px;
      left: 0;
    }

    .about-hero__badge-number {
      font-size: 3rem;
    }

    .about-hero__badge-text {
      font-size: 1rem;
    }

    .mission__title {
      font-size: 1.875rem;
    }

    .mission__image img {
      height: 280px;
    }
  }
</style>
