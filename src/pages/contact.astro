---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get a free roofing estimate from Everstead Roofing in Vancouver, WA. Call (360) 342-9525 or submit our contact form. Same-day quotes available."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Contact Us", url: "/contact" }
  ]}
>

  <section class="contact">
    <div class="container contact__inner">
      <div class="contact__content">
        <h1 class="contact__title">Any doubts?<br>Feel free to<br>contact us.</h1>
        <p class="contact__text">
          Have any questions? Submit your information, and we'll get back to you as soon as possible!
        </p>
      </div>

      <div class="contact__form-wrapper">
        <form class="contact__form" action="#" method="POST">
          <input
            type="text"
            name="name"
            placeholder="Full Name"
            class="contact__input"
            required
          >
          <input
            type="tel"
            name="phone"
            placeholder="Phone Number"
            class="contact__input"
            required
          >
          <textarea
            name="message"
            placeholder="Message"
            class="contact__textarea"
            rows="5"
            required
          ></textarea>
          <button type="submit" class="contact__submit">Book A Call</button>
        </form>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .contact {
    background-color: var(--color-white);
    padding: calc(var(--header-height) + var(--space-20)) 0 var(--space-20);
    min-height: 100vh;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .contact__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .contact__text {
    font-size: 1.375rem;
    color: #5a5a50;
    line-height: 1.7;
    max-width: 480px;
  }

  .contact__form-wrapper {
    background-color: #e8e8e0;
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__input,
  .contact__textarea {
    width: 100%;
    padding: var(--space-5) var(--space-6);
    background-color: #434038;
    border: none;
    border-radius: var(--radius-lg);
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-white);
  }

  .contact__input::placeholder,
  .contact__textarea::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .contact__input:focus,
  .contact__textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .contact__textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact__submit {
    width: 100%;
    padding: var(--space-5) var(--space-8);
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-lg);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 12px rgba(197, 97, 37, 0.4);
  }

  .contact__submit:hover {
    background-color: #b55520;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .contact__title {
      font-size: 3rem;
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding: calc(var(--header-height) + var(--space-12)) 0 var(--space-12);
      min-height: auto;
    }

    .contact__title {
      font-size: 2.5rem;
    }

    .contact__text {
      font-size: 1.125rem;
    }

    .contact__form-wrapper {
      padding: var(--space-6);
    }
  }

  @media (max-width: 480px) {
    .contact__title {
      font-size: 2rem;
    }

    .contact__text {
      font-size: 1rem;
    }
  }
</style>
