---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get a free roofing estimate from Everstead Roofing in Vancouver, WA. Call (360) 342-9525 or submit our contact form. Same-day quotes available."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Contact Us", url: "/contact" }
  ]}
>

  <section class="contact">
    <div class="container contact__inner">
      <div class="contact__content">
        <h1 class="contact__title">Any doubts?<br>Feel free to<br>contact us.</h1>
        <p class="contact__text">
          Have any questions? Submit your information, and we'll get back to you as soon as possible!
        </p>
      </div>

      <div class="contact__form-wrapper">
        <form class="contact__form" id="contact-form">
          <input
            type="text"
            name="name"
            placeholder="Full Name"
            class="contact__input"
            required
          >
          <input
            type="email"
            name="email"
            placeholder="Email Address"
            class="contact__input"
            required
          >
          <input
            type="tel"
            name="phone"
            placeholder="Phone Number"
            class="contact__input"
            required
          >
          <textarea
            name="message"
            placeholder="Message"
            class="contact__textarea"
            rows="5"
            required
          ></textarea>
          <!-- Cloudflare Turnstile -->
          <div class="cf-turnstile" data-sitekey="0x4AAAAAACOihWkSH5os4VWN" data-theme="dark"></div>

          <button type="submit" class="contact__submit">Book A Call</button>
        </form>

        <!-- Success message (hidden by default) -->
        <div id="form-success" class="form-success" style="display: none;">
          <div class="form-success__icon">&#10003;</div>
          <h3 class="form-success__title">Thank You!</h3>
          <p class="form-success__text">We've received your message and will get back to you shortly.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .contact {
    background-color: var(--color-white);
    padding: calc(var(--header-height) + var(--space-20)) 0 var(--space-20);
    min-height: 100vh;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .contact__title {
    font-family: var(--font-heading);
    font-size: 5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .contact__text {
    font-size: 1.375rem;
    color: #5a5a50;
    line-height: 1.7;
    max-width: 480px;
  }

  .contact__form-wrapper {
    background-color: #e8e8e0;
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__input,
  .contact__textarea {
    width: 100%;
    padding: var(--space-5) var(--space-6);
    background-color: #434038;
    border: none;
    border-radius: var(--radius-lg);
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-white);
  }

  .contact__input::placeholder,
  .contact__textarea::placeholder {
    color: rgba(255, 255, 255, 0.7);
  }

  .contact__input:focus,
  .contact__textarea:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .contact__textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact__submit {
    width: 100%;
    padding: var(--space-5) var(--space-8);
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-lg);
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 12px rgba(197, 97, 37, 0.4);
  }

  .contact__submit:hover {
    background-color: #b55520;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .contact__title {
      font-size: 3rem;
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding: calc(var(--header-height) + var(--space-12)) 0 var(--space-12);
      min-height: auto;
    }

    .contact__title {
      font-size: 2.5rem;
    }

    .contact__text {
      font-size: 1.125rem;
    }

    .contact__form-wrapper {
      padding: var(--space-6);
    }
  }

  @media (max-width: 480px) {
    .contact__title {
      font-size: 2rem;
    }

    .contact__text {
      font-size: 1rem;
    }
  }

  /* Success message styles */
  .form-success {
    text-align: center;
    padding: var(--space-10);
  }

  .form-success__icon {
    width: 64px;
    height: 64px;
    background-color: #22c55e;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--space-6);
    font-size: 2rem;
    color: white;
  }

  .form-success__title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  .form-success__text {
    font-size: 1.125rem;
    color: #5a5a50;
  }

  /* Loading state for button */
  .contact__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* Turnstile widget */
  .cf-turnstile {
    margin: var(--space-2) 0;
  }
</style>

<!-- Cloudflare Turnstile Script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  (function() {
    const FORMVAULT_URL = 'https://formvault.app/api/submit';
    const API_KEY = 'sk_live_ta5DXxZS_qVR70HZHyBMP49yLvS8yc1S';

    const form = document.getElementById('contact-form');
    const successMessage = document.getElementById('form-success');
    if (!form) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn?.textContent || 'Book A Call';

      // Show loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      // Gather form data
      const formData = new FormData(form);

      // Get Turnstile token
      const turnstileToken = formData.get('cf-turnstile-response');
      if (!turnstileToken) {
        alert('Please complete the security check.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
        return;
      }
      const data = {
        api_key: API_KEY,
        name: formData.get('name') || '',
        email: formData.get('email') || '',
        message: formData.get('message') || '',
        turnstile_token: turnstileToken,
        custom_fields: {}
      };

      // Collect extra fields (phone, etc.)
      formData.forEach((value, key) => {
        if (!['name', 'email', 'message', 'cf-turnstile-response'].includes(key)) {
          data.custom_fields[key] = value;
        }
      });

      try {
        const response = await fetch(FORMVAULT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          // Success - show success message
          form.style.display = 'none';
          if (successMessage) {
            successMessage.style.display = 'block';
          }
        } else {
          const err = await response.json();
          alert('Error: ' + (err.error || 'Something went wrong. Please try again.'));
          // Reset button
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        }
      } catch (error) {
        alert('Network error. Please check your connection and try again.');
        // Reset button
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      }
    });
  })();
</script>
