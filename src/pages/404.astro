---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Let's get you back on track.">

  <section class="error-page">
    <div class="container error-page__inner">
      <div class="error-page__content">
        <div class="error-page__code">
          <span class="error-page__4">4</span>
          <div class="error-page__roof">
            <svg viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M60 5L5 50H20V75H100V50H115L60 5Z" fill="#152536" stroke="#c56125" stroke-width="3"/>
              <rect x="45" y="50" width="30" height="25" fill="#c56125"/>
              <rect x="25" y="35" width="15" height="12" fill="#f4f4eb" stroke="#152536" stroke-width="2"/>
              <rect x="80" y="35" width="15" height="12" fill="#f4f4eb" stroke="#152536" stroke-width="2"/>
            </svg>
          </div>
          <span class="error-page__4">4</span>
        </div>

        <h1 class="error-page__title">Oops! Looks like this roof flew off.</h1>
        <p class="error-page__text">
          The page you're looking for seems to have gone missing. Don't worry—we're experts at finding and fixing things!
        </p>

        <div class="error-page__actions">
          <a href="/" class="btn btn--primary error-page__btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Back to Home
          </a>
          <a href="/contact" class="btn btn--outline error-page__btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Contact Us
          </a>
        </div>

        <div class="error-page__links">
          <p class="error-page__links-title">Or try one of these:</p>
          <div class="error-page__links-grid">
            <a href="/" class="error-page__link">Home</a>
            <a href="/about" class="error-page__link">About Us</a>
            <a href="/contact" class="error-page__link">Get a Quote</a>
            <a href="/contact" class="error-page__link">Contact Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-cream);
    padding: calc(var(--header-height) + var(--space-12)) 0 var(--space-12);
  }

  .error-page__inner {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .error-page__code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .error-page__4 {
    font-family: var(--font-heading);
    font-size: 10rem;
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1;
    text-shadow: 4px 4px 0 rgba(197, 97, 37, 0.2);
  }

  .error-page__roof {
    width: 140px;
    height: 100px;
    animation: float 3s ease-in-out infinite;
  }

  .error-page__roof svg {
    width: 100%;
    height: 100%;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(2deg);
    }
  }

  .error-page__title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .error-page__text {
    font-size: 1.25rem;
    color: #5a5a50;
    line-height: 1.7;
    margin-bottom: var(--space-10);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .error-page__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-12);
  }

  .error-page__btn {
    gap: var(--space-2);
  }

  .error-page__links {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-gray-200);
  }

  .error-page__links-title {
    font-size: 0.9375rem;
    color: #5a5a50;
    margin-bottom: var(--space-4);
  }

  .error-page__links-grid {
    display: flex;
    gap: var(--space-6);
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-page__link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
    position: relative;
  }

  .error-page__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-primary);
    transition: width var(--transition-fast);
  }

  .error-page__link:hover::after {
    width: 100%;
  }

  .error-page__link:hover {
    color: var(--color-primary-dark);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .error-page__4 {
      font-size: 6rem;
    }

    .error-page__roof {
      width: 100px;
      height: 70px;
    }

    .error-page__title {
      font-size: 1.75rem;
    }

    .error-page__text {
      font-size: 1.0625rem;
    }

    .error-page__actions {
      flex-direction: column;
      align-items: center;
    }

    .error-page__btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .error-page__4 {
      font-size: 4.5rem;
    }

    .error-page__roof {
      width: 80px;
      height: 56px;
    }

    .error-page__title {
      font-size: 1.5rem;
    }

    .error-page__links-grid {
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>
