---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { locations } from '../../data/locations';
import {
  currentTier,
  lowestRate,
  highestRate,
  materialUpliftPct,
  estimateTotal,
  formatDollars,
  taxNote,
} from '../../data/pricing';

export async function getStaticPaths() {
  return locations.map((location) => ({
    params: { city: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
const { holiday } = location;
const siteUrl = Astro.site.origin;
const pageUrl = `${siteUrl}/christmas-lights/${location.slug}`;

/**
 * Deliberately lean on shared sections.
 *
 * The obvious build here reuses HolidayWhatsIncluded and HolidayPricing on every
 * city page. That would make roughly half of all five pages byte-identical, which
 * is precisely the doorway-page signal these pages have to avoid on a domain with
 * no authority to spend. Everything below the hero is city-specific; the full
 * offering detail lives on the main lights page and is linked, not duplicated.
 *
 * Vancouver is absent by design, same as the roofing set — the main lights page
 * already targets it, and a second page chasing the same term would compete with
 * it rather than extend reach.
 */

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `Christmas Light Installation in ${location.city}, WA`,
  serviceType: 'Christmas Light Installation',
  description: holiday.angle,
  url: pageUrl,
  provider: {
    '@type': 'RoofingContractor',
    name: 'Everstead Roofing Co',
    url: siteUrl,
    telephone: '+1-360-342-9525',
  },
  areaServed: {
    '@type': 'City',
    name: location.city,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: `${location.county}, Washington`,
    },
  },
  offers: {
    '@type': 'Offer',
    url: pageUrl,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      priceCurrency: 'USD',
      price: currentTier.rate,
      minPrice: lowestRate,
      maxPrice: highestRate,
      valueAddedTaxIncluded: false,
      unitCode: 'FOT',
      unitText: 'linear foot of roofline',
      referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'FOT' },
      description: `Per linear foot of roofline, plus a ${materialUpliftPct}% material charge. Washington sales tax stated separately.`,
    },
  },
};

// Emitted as its own block rather than folded into an @graph with the Service
// above, since BaseLayout now accepts an array and renders one script per entry.
// The roofing city pages reach the same result via @graph — either is valid.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: holiday.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title={`Christmas Light Installation in ${location.city}, WA`}
  description={`Professional Christmas light installation in ${location.city}, WA. ${holiday.angle} $${currentTier.rate.toFixed(2)} per linear foot if you book by ${currentTier.deadline}; installation and January removal included.`}
  jsonLd={[serviceSchema, faqSchema]}
  logo="/eversteadlogoholiday.svg"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Christmas Light Installation', url: '/christmas-light-installation-vancouver-wa' },
    { name: `${location.city}, WA`, url: `/christmas-lights/${location.slug}` },
  ]}
>
  <section class="lights-hero">
    <div class="container">
      <p class="lights-hero__eyebrow">{location.county}, Washington</p>
      <h1 class="lights-hero__title">Christmas Light Installation in {location.city}, WA</h1>
      <p class="lights-hero__text prose">{holiday.intro}</p>
      <div class="lights-hero__actions">
        <a href="/contact" class="btn btn--primary">Get my estimate</a>
        <a href="tel:+13603429525" class="lights-hero__phone">(360) 342-9525</a>
      </div>
      <p class="lights-hero__drive">
        {location.city} is {location.driveTime}. Text four photos for a same-day estimate;
        a 50% deposit reserves your install date and holds the rate. {taxNote}
      </p>
    </div>
  </section>

  <section class="section considerations">
    <div class="container">
      <h2 class="considerations__title">What lighting a {location.city} home actually involves</h2>
      <p class="considerations__lead prose">
        Rooflines, exposure and access differ across Clark County, and they change both
        the plan and the price. These are the things that matter here specifically.
      </p>

      <div class="considerations__grid">
        {holiday.considerations.map((item, i) => (
          <article class="consideration">
            <span class="consideration__index">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="consideration__title">{item.title}</h3>
            <p class="consideration__body">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight section--cream">
    <div class="container lights-included">
      <h2 class="lights-included__title">Every {location.city} install includes</h2>
      <ul class="lights-included__list">
        <li>Commercial-grade C9 LED lights</li>
        <li>Non-damaging clips &mdash; no holes, nails or staples</li>
        <li>Outdoor cords and a timer</li>
        <li>Takedown in January</li>
        <li>Service warranty for the whole season</li>
        <li>Optional year-round storage</li>
      </ul>
      <p class="lights-included__note">
        <strong>${currentTier.rate.toFixed(2)} per linear foot</strong> booked by {currentTier.deadline},
        plus {materialUpliftPct}% material. A 200-foot roofline is about
        {formatDollars(estimateTotal(200, currentTier.rate))}. {taxNote}
        <a href="/christmas-light-installation-vancouver-wa">See the full rate card &rarr;</a>
      </p>
    </div>
  </section>

  <section class="section section--tight areas">
    <div class="container">
      <h2 class="areas__title">Around {location.city}</h2>
      <ul class="areas__list">
        {location.neighbourhoods.map((n) => <li>{n}</li>)}
      </ul>
      <p class="areas__note">
        Not listed? We light homes throughout {location.county}.
        <a href="/contact"> Ask about your address</a>.
      </p>
    </div>
  </section>

  <section class="section section--tight lights-faq">
    <div class="container">
      <h2 class="lights-faq__title">Christmas light questions in {location.city}</h2>
      <div class="lights-faq__list">
        {holiday.faqs.map((faq) => (
          <details class="lights-faq__item">
            <summary class="lights-faq__q" set:html={faq.question} />
            <p class="lights-faq__a" set:html={faq.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title={`Book your ${location.city} install`}
    text={`Christmas light installation in ${location.city} and throughout ${location.county}. Commercial-grade LEDs, non-damaging clips, and January takedown included. $${currentTier.rate.toFixed(2)} per foot booked by ${currentTier.deadline}—the rate rises after that.`}
    subtext="Text 4 photos for a same-day estimate. A 50% deposit reserves your date and holds the rate. Plus WA sales tax, shown separately."
    buttonLabel="Get My Lighting Estimate"
  />
</BaseLayout>

<style>
  .lights-hero {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: calc(var(--header-height) + var(--space-14)) 0 var(--space-14);
  }

  .lights-hero__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-light);
    margin-bottom: var(--space-4);
  }

  .lights-hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    max-width: 18ch;
    text-wrap: balance;
    margin-bottom: var(--space-6);
  }

  .lights-hero__text {
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-8);
  }

  .lights-hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .lights-hero__phone {
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    font-size: var(--text-lg);
    color: var(--color-white);
  }

  .lights-hero__phone:hover {
    color: var(--color-primary-light);
  }

  .lights-hero__drive {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    max-width: 54ch;
    line-height: var(--leading-loose);
  }

  .considerations__title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    max-width: 22ch;
    margin-bottom: var(--space-4);
  }

  .considerations__lead {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
    margin-bottom: var(--space-12);
  }

  .considerations__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-10);
  }

  .consideration__index {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .consideration__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    margin-bottom: var(--space-3);
    line-height: var(--leading-snug);
  }

  .consideration__body {
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .lights-included__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    margin-bottom: var(--space-6);
  }

  .lights-included__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3) var(--space-8);
  }

  .lights-included__list li {
    position: relative;
    padding-left: var(--space-6);
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .lights-included__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
  }

  .lights-included__note {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-loose);
  }

  .lights-included__note strong {
    color: var(--color-navy);
  }

  .lights-included__note a {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .areas__title,
  .lights-faq__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    margin-bottom: var(--space-6);
  }

  .areas__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .areas__list li {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-navy);
    background-color: var(--color-cream);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-5);
  }

  .areas__note {
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .areas__note a {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .lights-faq__list {
    max-width: var(--measure);
  }

  .lights-faq__item {
    border-bottom: 1px solid var(--color-gray-200);
  }

  .lights-faq__q {
    cursor: pointer;
    list-style: none;
    padding: var(--space-5) var(--space-8) var(--space-5) 0;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    position: relative;
  }

  .lights-faq__q::-webkit-details-marker {
    display: none;
  }

  .lights-faq__q::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--text-xl);
    font-weight: var(--font-normal);
    color: var(--color-primary);
  }

  .lights-faq__item[open] .lights-faq__q::after {
    content: '\2212';
  }

  .lights-faq__a {
    padding: 0 var(--space-8) var(--space-6) 0;
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .lights-hero {
      padding: calc(var(--header-height) + var(--space-10)) 0 var(--space-10);
    }

    .lights-hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }
  }
</style>
