---
interface Props {
  href?: string;
  variant?: 'primary' | 'outline' | 'white';
  class?: string;
}

const {
  href,
  variant = 'primary',
  class: className = '',
} = Astro.props;

const classes = `btn btn--${variant} ${className}`.trim();
const Tag = href ? 'a' : 'button';
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}
