---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  excerpt: string;
  image: ImageMetadata;
  date: string;
  href: string;
}

const { title, excerpt, image, date, href } = Astro.props;
---

<article class="news-card">
  <a href={href} class="news-card__image-link">
    <Image src={image} alt={`${title} - Everstead Roofing blog`} class="news-card__image" width={400} height={280} quality={80} format="webp" loading="lazy" />
  </a>
  <div class="news-card__content">
    <span class="news-card__meta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      {date}
    </span>
    <h3 class="news-card__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="news-card__excerpt">{excerpt}</p>
  </div>
</article>

<style>
  .news-card {
    transition: transform var(--transition-base);
  }

  .news-card:hover {
    transform: translateY(-4px);
  }

  .news-card__image-link {
    display: block;
    overflow: hidden;
    border-radius: 16px;
    margin-bottom: var(--space-4);
  }

  .news-card__image {
    width: 100%;
    height: 280px;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .news-card:hover .news-card__image {
    transform: scale(1.05);
  }

  .news-card__content {
    padding: 0;
  }

  .news-card__meta {
    font-size: 0.9375rem;
    color: #c56125;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .news-card__meta svg {
    flex-shrink: 0;
  }

  .news-card__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .news-card__title a {
    color: #152536;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .news-card__title a:hover {
    color: #c56125;
  }

  .news-card__excerpt {
    font-size: 1rem;
    color: #5a5a50;
    line-height: 1.6;
  }
</style>
