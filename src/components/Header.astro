---
// Header component - appears on all pages
const navLinks = [
  { label: 'HOME', href: '/' },
  { label: 'ABOUT', href: '/about' },
  { label: 'SERVICES', href: '/contact' },
  { label: 'GET QUOTE', href: '/contact' },
  { label: 'CONTACT', href: '/contact' },
  { label: 'HOLIDAY', href: '/holiday' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/eversteadlogo.svg" alt="Everstead Roofing - Vancouver WA Roofing Contractor" width="160" height="40">
    </a>

    <nav class="header__nav">
      {navLinks.map((link) => (
        <a href={link.href} class="header__nav-link">{link.label}</a>
      ))}
    </nav>

    <a href="/contact" class="btn btn--primary header__cta">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Book Your Install Today
    </a>

    <button class="header__mobile-toggle" aria-label="Toggle menu" data-mobile-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <nav class="header__mobile-nav" data-mobile-nav>
    {navLinks.map((link) => (
      <a href={link.href} class="header__mobile-link">{link.label}</a>
    ))}
    <a href="/contact" class="btn btn--primary header__mobile-cta">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Book Your Install Today
    </a>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-mobile-toggle]');
  const nav = document.querySelector('[data-mobile-nav]');
  const header = document.querySelector('.header');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    header?.classList.toggle('menu-open', isOpen);
    toggle?.setAttribute('aria-expanded', String(isOpen));
  });

  // Close menu when clicking a link
  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      header?.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: var(--color-navy);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .header__logo img {
    height: 80px;
    width: auto;
  }

  .header__nav {
    display: flex;
    align-items: center;
    height: 100%;
  }

  .header__nav-link {
    font-size: 0.9375rem;
    font-weight: var(--font-bold);
    color: #f4f4eb;
    letter-spacing: 0.5px;
    padding: 0 var(--space-6);
    height: var(--header-height);
    display: flex;
    align-items: center;
    transition: all var(--transition-fast);
    position: relative;
  }

  .header__nav-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-primary);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .header__nav-link:hover {
    background-color: var(--color-cream);
    color: var(--color-primary);
  }

  .header__nav-link:hover::before {
    opacity: 1;
  }

  .header__cta {
    padding: var(--space-4) var(--space-8);
    font-size: 0.9375rem;
    gap: var(--space-2);
  }

  .header__cta svg {
    flex-shrink: 0;
  }

  .header__mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    background: none;
    border: none;
    cursor: pointer;
  }

  .header__mobile-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-white);
    transition: all var(--transition-fast);
  }

  /* Mobile Navigation */
  .header__mobile-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-navy);
    padding: var(--space-6);
    flex-direction: column;
    gap: var(--space-2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transform: translateY(-10px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.3s ease, opacity 0.3s ease, visibility 0.3s ease;
  }

  .header__mobile-nav.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-4) var(--space-4);
    font-size: 1rem;
    font-weight: var(--font-semibold);
    color: #f4f4eb;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .header__mobile-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .header__mobile-cta {
    margin-top: var(--space-4);
    justify-content: center;
  }

  /* Hamburger animation */
  .header.menu-open .header__mobile-toggle span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .header.menu-open .header__mobile-toggle span:nth-child(2) {
    opacity: 0;
  }

  .header.menu-open .header__mobile-toggle span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .header__nav {
      display: none;
    }

    .header__cta {
      display: none;
    }

    .header__mobile-toggle {
      display: flex;
    }

    .header__mobile-nav {
      display: flex;
    }

    .header__logo img {
      height: 60px;
    }
  }

  @media (max-width: 480px) {
    .header__logo img {
      height: 50px;
    }
  }
</style>
