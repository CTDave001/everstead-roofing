---
import { Image } from 'astro:assets';
import aboutVisionImg from '../../assets/images/about-vision.jpg';

const pillars = [
  {
    label: 'Our Mission',
    paths: [
      '<circle cx="12" cy="12" r="10"></circle>',
      '<circle cx="12" cy="12" r="6"></circle>',
      '<circle cx="12" cy="12" r="2"></circle>',
      '<path d="M12 2v4M12 18v4"></path>',
    ],
  },
  {
    label: 'Our Vision',
    paths: [
      '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>',
      '<circle cx="12" cy="12" r="3"></circle>',
      '<path d="M12 5v-2M12 21v-2M5 12H3M21 12h-2"></path>',
    ],
  },
  {
    label: 'Trusted Services',
    paths: [
      '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
      '<polyline points="9 12 11 14 15 10"></polyline>',
    ],
  },
];
---

<section class="about-panorama-section">
  <div class="about-panorama">
    <Image src={aboutVisionImg} alt="Panoramic view of rooftops in Southwest Washington neighborhood" width={1920} height={600} quality={80} format="webp" />
    <div class="about-panorama__fade"></div>
  </div>
  <div class="container pillars__wrapper">
    <div class="pillars__grid stagger-children">
      {pillars.map((pillar) => (
        <div class="pillars__card animate-on-scroll fade-up">
          <div class="pillars__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={pillar.paths.join('')} />
          </div>
          <span class="pillars__label">{pillar.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-panorama-section {
    position: relative;
    margin-top: var(--space-16);
  }

  .about-panorama {
    position: relative;
    width: 100%;
  }

  .about-panorama img {
    width: 100%;
    height: 700px;
    object-fit: cover;
    object-position: center top;
  }

  .about-panorama__fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 280px;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.7), white);
    pointer-events: none;
  }

  .pillars__wrapper {
    position: relative;
    margin-top: -180px;
    padding-bottom: var(--space-12);
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .pillars__card {
    background-color: #e5e5db;
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    box-shadow: var(--shadow-md);
    min-height: 180px;
  }

  .pillars__icon {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .pillars__label {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.2;
  }

  @media (max-width: 1024px) {
    .pillars__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .pillars__wrapper {
      margin-top: -80px;
    }

    .about-panorama img {
      height: 400px;
    }
  }

  @media (max-width: 768px) {
    .about-panorama-section {
      margin-top: var(--space-12);
    }

    .about-panorama img {
      height: 350px;
    }

    .pillars__wrapper {
      margin-top: -60px;
    }

    .pillars__card {
      padding: var(--space-6) var(--space-5);
    }

    .pillars__icon {
      width: 50px;
      height: 50px;
    }

    .pillars__icon svg {
      width: 24px;
      height: 24px;
    }

    .pillars__label {
      font-size: 1rem;
    }
  }
</style>
