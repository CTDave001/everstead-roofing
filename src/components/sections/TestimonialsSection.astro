---
import TrustProof from '../TrustProof.astro';
---
<section class="section section--cream">
 <div class="container">
  <h2 class="section-title">Know what happens next</h2>
  <div class="next-steps">
   <article><h3>1. Tell us about your project</h3><p>Call, text photos, or request a free estimate. We serve Vancouver and Clark County.</p></article>
   <article><h3>2. Review your written quote</h3><p>See the scope, price, timing, and applicable warranty terms before you decide.</p></article>
   <article><h3>3. Choose your next step</h3><p>Ask questions and confirm the work when you are ready. Requesting an estimate does not book an installation.</p></article>
  </div>
  <TrustProof />
  <a class="btn btn--primary" href="/contact" style="margin-top:1.5rem">Get My Free Estimate</a>
 </div>
</section>
<style>.next-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;margin-top:2rem}.next-steps h3{font-size:1.2rem;margin-bottom:.75rem}.next-steps p{line-height:1.7}@media(max-width:700px){.next-steps{grid-template-columns:1fr}}</style>
