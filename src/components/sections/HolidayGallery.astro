---
import { Image } from 'astro:assets';
import galleryLarge from '../../assets/images/lights-two-story-complex.jpg';
import gallerySmall1 from '../../assets/images/lights-wrapped-columns-trees.jpg';
import gallerySmall2 from '../../assets/images/detail-clip-no-holes.jpg';

/**
 * The three images make an argument rather than just decorating.
 *
 * Large: a two-storey home with multiple gables, every eave and peak outlined at
 * even spacing. That is the work the pricing page charges more for, and it needs
 * to be visible before anyone reads why.
 *
 * Small 1: wrapped columns and a wrapped conifer — the thing quoted separately,
 * shown so people know to ask for it.
 *
 * Small 2: a macro of a bulb in a clip on a shingle edge. The whole site claims
 * "no holes, no staples"; this is the only place that claim is demonstrated
 * rather than asserted, and it is the difference between a promise and proof.
 *
 * Alt text describes what is depicted, not who did it — these are illustrative
 * until the real season's photography replaces them.
 */
---

<section class="holiday-gallery">
  <div class="holiday-gallery__images">
    <div class="holiday-gallery__image holiday-gallery__image--large animate-on-scroll fade-up">
      <Image src={galleryLarge} alt="A two-storey home at dusk with every gable, dormer and eave outlined in evenly spaced warm-white C9 bulbs" widths={[600, 900, 1200]} sizes="(max-width: 768px) 100vw, 66vw" format="webp" quality={78} loading="lazy" />
    </div>
    <div class="holiday-gallery__image holiday-gallery__image--small animate-on-scroll fade-up">
      <Image src={gallerySmall1} alt="Porch columns and a mature conifer wrapped in tight, evenly spaced warm-white lights" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 33vw" format="webp" quality={78} loading="lazy" />
    </div>
    <div class="holiday-gallery__image holiday-gallery__image--small animate-on-scroll fade-up">
      <Image src={gallerySmall2} alt="Close-up of a C9 bulb held by a plastic clip gripping the shingle edge — no nails, staples or holes" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 33vw" format="webp" quality={78} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .holiday-gallery {
    background-color: #000;
    padding: var(--space-2) 0;
  }

  .holiday-gallery__images {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    min-height: 600px;
  }

  .holiday-gallery__image {
    overflow: hidden;
  }

  .holiday-gallery__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .holiday-gallery__image:hover img {
    transform: scale(1.05);
  }

  .holiday-gallery__image--large {
    grid-row: span 2;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .holiday-gallery__images {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      min-height: auto;
    }

    .holiday-gallery__image--large {
      grid-row: auto;
    }

    .holiday-gallery__image {
      height: 250px;
    }
  }
</style>
