---
// Holiday lights gallery section
---

<section class="holiday-gallery">
  <div class="holiday-gallery__images">
    <div class="holiday-gallery__image holiday-gallery__image--large animate-on-scroll fade-up">
      <img src="/images/holiday-gallery-1.jpg" alt="Stunning Christmas lights display on Vancouver WA home" loading="lazy">
    </div>
    <div class="holiday-gallery__image holiday-gallery__image--small animate-on-scroll fade-up">
      <img src="/images/holiday-gallery-2.jpg" alt="Professional Christmas light installation on roofline" loading="lazy">
    </div>
    <div class="holiday-gallery__image holiday-gallery__image--small animate-on-scroll fade-up">
      <img src="/images/holiday-gallery-3.jpg" alt="Holiday lights decorating Southwest Washington home" loading="lazy">
    </div>
  </div>
</section>

<style>
  .holiday-gallery {
    background-color: #000;
    padding: var(--space-2) 0;
  }

  .holiday-gallery__images {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    min-height: 600px;
  }

  .holiday-gallery__image {
    overflow: hidden;
  }

  .holiday-gallery__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .holiday-gallery__image:hover img {
    transform: scale(1.05);
  }

  .holiday-gallery__image--large {
    grid-row: span 2;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .holiday-gallery__images {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      min-height: auto;
    }

    .holiday-gallery__image--large {
      grid-row: auto;
    }

    .holiday-gallery__image {
      height: 250px;
    }
  }
</style>
