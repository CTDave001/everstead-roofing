---
import { Image } from 'astro:assets';
import galleryLarge from '../../assets/images/holiday-hero.jpg';
import gallerySmall1 from '../../assets/images/holiday-house-2.webp';
import gallerySmall2 from '../../assets/images/holiday-house-3.webp';

/**
 * These were plain <img> tags pointing at public/, so they shipped at source
 * weight — holiday-house-3 alone was 1.8MB for a 1500x1000 image, which is a
 * near-lossless encode nobody chose deliberately. Astro now resizes and
 * re-encodes them, and emits width/height so the grid does not shift as they
 * load.
 */
---

<section class="holiday-gallery">
  <div class="holiday-gallery__images">
    <div class="holiday-gallery__image holiday-gallery__image--large animate-on-scroll fade-up">
      <Image src={galleryLarge} alt="Stunning Christmas lights display on Vancouver WA home" widths={[600, 900, 1200]} sizes="(max-width: 768px) 100vw, 66vw" format="webp" quality={78} loading="lazy" />
    </div>
    <div class="holiday-gallery__image holiday-gallery__image--small animate-on-scroll fade-up">
      <Image src={gallerySmall1} alt="Professional Christmas light installation on roofline" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 33vw" format="webp" quality={78} loading="lazy" />
    </div>
    <div class="holiday-gallery__image holiday-gallery__image--small animate-on-scroll fade-up">
      <Image src={gallerySmall2} alt="Holiday lights decorating Southwest Washington home" widths={[400, 600]} sizes="(max-width: 768px) 100vw, 33vw" format="webp" quality={78} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .holiday-gallery {
    background-color: #000;
    padding: var(--space-2) 0;
  }

  .holiday-gallery__images {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    min-height: 600px;
  }

  .holiday-gallery__image {
    overflow: hidden;
  }

  .holiday-gallery__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .holiday-gallery__image:hover img {
    transform: scale(1.05);
  }

  .holiday-gallery__image--large {
    grid-row: span 2;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .holiday-gallery__images {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      min-height: auto;
    }

    .holiday-gallery__image--large {
      grid-row: auto;
    }

    .holiday-gallery__image {
      height: 250px;
    }
  }
</style>
