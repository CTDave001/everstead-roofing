---
import {currentTier,exampleRooflines,estimateTotal,formatDollars,taxNote} from '../../data/pricing';
---
<section class="holiday-pricing section" id="pricing">
 <div class="container">
  <div class="section-header section-header--center">
   <h2 class="section-title">One clear roofline price: ${currentTier.rate.toFixed(2)}/ft</h2>
   <p class="section-subtitle">Lights, materials, installation, outdoor cords, timer, and January removal included. {taxNote}</p>
  </div>
  <div class="holiday-pricing__table-wrap">
   <h3 class="holiday-pricing__table-title">What that works out to</h3>
   <div class="holiday-pricing__scroll"><table class="holiday-pricing__table">
    <thead><tr><th scope="col">Roofline length</th><th scope="col">Full-service price, before tax</th></tr></thead>
    <tbody>{exampleRooflines.map(feet => <tr><th scope="row">{feet} ft</th><td>{formatDollars(estimateTotal(feet))}</td></tr>)}</tbody>
   </table></div>
   <p class="holiday-pricing__table-note">For roofline lighting. Tree wrapping, storage, and any access equipment needed are scoped separately and agreed in your written quote before you book. No extra work is added without your approval.</p>
  </div>
  <div class="holiday-pricing__cta">
   <p class="holiday-pricing__cta-text">Text four photos of your home, one from each corner. We will confirm the footage, access, and written price. A 50% deposit reserves your installation date after you approve the quote.</p>
   <div class="holiday-pricing__cta-actions"><a href="sms:+13605583350" class="btn btn--primary">Text Photos for an Estimate</a><a href="/contact?service=Christmas%20Light%20Installation" class="holiday-pricing__phone">Request an estimate online</a></div>
  </div>
 </div>
</section>
<style>
  .holiday-pricing {
    background-color: var(--color-white);
  }

  .holiday-pricing__formula {
    max-width: 720px;
    margin: 0 auto var(--space-16);
    padding: var(--space-8);
    text-align: center;
    background-color: var(--color-cream);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-gray-200);
  }

  .holiday-pricing__formula-line {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    margin-bottom: var(--space-4);
  }

  .holiday-pricing__op {
    color: var(--color-primary);
  }

  .holiday-pricing__formula-note {
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .holiday-pricing__ladder {
    margin-bottom: var(--space-16);
  }

  .holiday-pricing__ladder-title,
  .holiday-pricing__table-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .holiday-pricing__ladder-lead {
    max-width: 56ch;
    margin: 0 auto var(--space-10);
    text-align: center;
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .holiday-pricing__tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-5);
    max-width: 760px;
    margin: 0 auto var(--space-8);
  }

  .rate-tier {
    position: relative;
    text-align: center;
    padding: var(--space-8) var(--space-5) var(--space-6);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    background-color: var(--color-white);
  }

  .rate-tier--current {
    border-color: var(--color-primary);
    border-width: 2px;
    background-color: var(--color-cream);
  }

  .rate-tier__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .rate-tier__label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-light);
    margin-bottom: var(--space-2);
  }

  .rate-tier__rate {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    line-height: 1;
  }

  .rate-tier--current .rate-tier__rate {
    color: var(--color-primary);
  }

  .rate-tier__rate span {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text-light);
  }

  .holiday-pricing__saving {
    max-width: 56ch;
    margin: 0 auto;
    text-align: center;
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--color-text-muted);
  }

  .holiday-pricing__saving strong {
    color: var(--color-primary);
    font-weight: var(--font-bold);
  }

  .holiday-pricing__table-wrap {
    margin-bottom: var(--space-16);
  }

  /* Wide content scrolls inside its own container; the page body must not. */
  .holiday-pricing__scroll {
    overflow-x: auto;
    max-width: 760px;
    margin: 0 auto var(--space-5);
  }

  .holiday-pricing__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 460px;
  }

  .holiday-pricing__table th,
  .holiday-pricing__table td {
    padding: var(--space-4);
    text-align: right;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .holiday-pricing__table thead th {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom-width: 2px;
  }

  .holiday-pricing__table thead th span {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-normal);
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-text-light);
    margin-top: var(--space-1);
  }

  .holiday-pricing__table tbody th {
    text-align: left;
    font-family: var(--font-heading);
    font-weight: var(--font-bold);
    color: var(--color-navy);
  }

  .holiday-pricing__table td {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .holiday-pricing__table td.is-current {
    color: var(--color-primary);
    font-weight: var(--font-bold);
    background-color: var(--color-cream);
  }

  .holiday-pricing__table-note {
    max-width: 60ch;
    margin: 0 auto;
    text-align: center;
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: var(--color-text-light);
  }

  .holiday-pricing__cta {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-10) var(--space-8);
    background-color: var(--color-navy);
    border-radius: var(--radius-lg);
  }

  .holiday-pricing__cta-text {
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-8);
  }

  .holiday-pricing__cta-text strong {
    color: var(--color-white);
    font-weight: var(--font-semibold);
  }

  .holiday-pricing__cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .holiday-pricing__phone {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
    transition: color var(--transition-fast);
  }

  .holiday-pricing__phone:hover {
    color: var(--color-white);
  }

  @media (max-width: 640px) {
    .holiday-pricing__formula,
    .holiday-pricing__cta {
      padding: var(--space-8) var(--space-5);
    }

    .holiday-pricing__cta-actions {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
