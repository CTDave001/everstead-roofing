---
import NewsCard from '../NewsCard.astro';

const newsItems = [
  {
    title: 'Exploring different roofing materials',
    excerpt: "We'll ensure that you focus on the opportunities that maximize competitive advantage.",
    image: '/images/news-1.jpg',
    date: 'August 10, 2024',
    href: '/blog/exploring-roofing-materials',
  },
  {
    title: 'Protecting your home from damage',
    excerpt: 'Regular roof maintenance is essential for prolonging the life of your roof and preventing costly repairs.',
    image: '/images/news-2.jpg',
    date: 'July 1, 2024',
    href: '/blog/protecting-home-from-damage',
  },
  {
    title: 'We will make your old roof to new.',
    excerpt: 'With so many roofing materials available, choosing the right one can be overwhelming.',
    image: '/images/news-3.jpg',
    date: 'June 17, 2024',
    href: '/blog/old-roof-to-new',
  },
];
---

<section class="news section section--cream">
  <div class="container">
    <div class="section-header section-header--center animate-on-scroll fade-up">
      <h2 class="section-title">Our latest news</h2>
      <p class="section-subtitle">
        Our customers are at the heart of our company, and with over 7 years of experience in the industry we understand every articles in details.
      </p>
    </div>

    <div class="news__grid stagger-children">
      {newsItems.map((item, index) => (
        <div class="animate-on-scroll fade-up">
          <NewsCard
            title={item.title}
            excerpt={item.excerpt}
            image={item.image}
            date={item.date}
            href={item.href}
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .news .section-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4rem;
    font-weight: 700;
    color: #434338;
    line-height: 1.08;
  }

  .news .section-subtitle {
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .news__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .news__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .news__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
