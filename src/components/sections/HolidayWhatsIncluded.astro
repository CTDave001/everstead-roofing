---
const features = [
  {
    title: 'C9 LED lights',
    subtitle: '(outdoor use)',
    description: 'Commercial-grade C9 bulbs',
    icon: 'lightbulb',
  },
  {
    title: 'Non-damaging',
    subtitle: 'clips',
    description: 'No holes, no damage',
    icon: 'clip',
  },
  {
    title: 'Outdoor cords &',
    subtitle: 'timer',
    description: 'Set it and forget it',
    icon: 'timer',
  },
  {
    title: 'Pre-install &',
    subtitle: 'January removal',
    description: 'Full-service from start to finish',
    icon: 'calendar',
  },
  {
    title: 'Phone',
    subtitle: 'Consultation',
    description: 'Quick estimate over the phone',
    icon: 'phone',
  },
  {
    title: 'Optional storage',
    subtitle: '',
    description: 'We store your lights year-round',
    icon: 'storage',
  },
  {
    title: 'All-over service',
    subtitle: 'Warranty',
    description: 'We fix it if it fails',
    icon: 'shield',
  },
];

const icons: Record<string, string> = {
  lightbulb: 'M9 21h6M12 3a6 6 0 0 0-6 6c0 2.22 1.21 4.16 3 5.19V17a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-2.81c1.79-1.03 3-2.97 3-5.19a6 6 0 0 0-6-6z',
  clip: 'M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48',
  timer: 'M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83M12 8v4l2 2',
  calendar: 'M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18',
  phone: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.32 1.6.56 2.37a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.77.24 1.56.43 2.37.56A2 2 0 0 1 22 16.92z',
  storage: 'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4',
};
---

<section class="whats-included">
  <div class="whats-included__bg">
    <img src="/images/holiday-house-2.jpg" alt="Beautiful home decorated with Christmas lights in Vancouver WA" loading="lazy">
  </div>
  <div class="container">
    <div class="whats-included__content animate-on-scroll fade-up">
      <h2 class="whats-included__title">What's Included</h2>
      <p class="whats-included__subtitle">Everything you need for a safe, beautiful, worry-free display.</p>

      <div class="whats-included__grid">
        {features.map((feature) => (
          <div class="feature-card animate-on-scroll fade-up">
            <div class="feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={icons[feature.icon]} />
              </svg>
            </div>
            <div class="feature-card__text">
              <h3 class="feature-card__title">
                {feature.title}
                {feature.subtitle && <span>{feature.subtitle}</span>}
              </h3>
              <p class="feature-card__description">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .whats-included {
    position: relative;
    padding: var(--space-24) 0;
    overflow: hidden;
  }

  .whats-included__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60%;
    z-index: 0;
  }

  .whats-included__bg::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.8));
  }

  .whats-included__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .whats-included__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-top: var(--space-32);
  }

  .whats-included__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  .whats-included__subtitle {
    font-size: 1.125rem;
    color: #5a5a50;
    margin-bottom: var(--space-12);
  }

  .whats-included__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .feature-card {
    background: #e5e5db;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-align: left;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .feature-card__icon {
    width: 48px;
    height: 48px;
    background: var(--color-primary);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .feature-card__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.3;
    margin-bottom: var(--space-2);
  }

  .feature-card__title span {
    display: block;
    font-weight: 600;
  }

  .feature-card__description {
    font-size: 0.875rem;
    color: #5a5a50;
    line-height: 1.5;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .whats-included__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .whats-included__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .whats-included__title {
      font-size: 2.25rem;
    }

    .whats-included__content {
      padding-top: var(--space-20);
    }
  }

  @media (max-width: 480px) {
    .whats-included__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
