---
import { services, serviceIcons as icons } from '../../data/services';
---

<section class="services section section--feature section--cream">
  <div class="container services__inner">
    <div class="services__sidebar animate-on-scroll fade-up">
      <h2 class="services__title">Roofing services done to last.</h2>
      <p class="services__intro">
        We serve homeowners and landlords within 60 miles of Vancouver, WA—delivering precise installs, clean sites, and transparent pricing.
      </p>
      <a href="/contact" class="btn btn--primary">Get a Free Quote</a>
      <a href="/services" class="services__all">See all services &rarr;</a>
    </div>

    <div class="services__grid stagger-children">
      {services.map((service) => (
        <a href={service.href ?? `/services#${service.slug}`} class="service-card animate-on-scroll fade-up">
          <div class="service-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[service.icon]} />
            </svg>
          </div>
          <h3 class="service-card__title">{service.title}</h3>
          <p class="service-card__description">{service.summary}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services__inner {
    display: grid;
    grid-template-columns: 1fr 1.8fr;
    gap: var(--space-16);
    align-items: start;
  }

  .services__sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-8));
  }

  .services__title {
    font-family: var(--font-heading);
    /* Was a fixed 4rem with two breakpoint overrides under it. */
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    font-weight: 700;
    color: #434338;
    line-height: 1.08;
    margin-bottom: var(--space-8);
  }

  .services__intro {
    color: #5a5a50;
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }

  .services__all {
    display: inline-block;
    margin-left: var(--space-6);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .services__all:hover {
    color: var(--color-navy);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12) var(--space-16);
  }

  .service-card {
    padding: var(--space-6);
    text-decoration: none;
    display: block;
    border-radius: var(--radius-lg);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .service-card:hover {
    background-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }

  .service-card__icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-5);
    color: #c56125;
  }

  .service-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .service-card__title {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: #434338;
    margin-bottom: var(--space-3);
    transition: color 0.2s ease;
  }

  .service-card:hover .service-card__title {
    color: #c56125;
  }

  .service-card__description {
    font-size: 1.0625rem;
    color: #5a5a50;
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .services__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .services__sidebar {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
