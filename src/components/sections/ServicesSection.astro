---
// Services section with sidebar layout
const services = [
  {
    title: 'Free Inspection',
    description: 'Schedule a complimentary inspection, and our team will assess your roof\'s condition at your convenience.',
    icon: 'inspection',
    href: '/service/free-inspection',
  },
  {
    title: 'Roof Repair',
    description: 'Leak fixes, flashing upgrades, venting corrections, and emergency tarping to stop water fast.',
    icon: 'repair',
    href: '/service/roof-repair',
  },
  {
    title: 'Roof Replacement',
    description: 'Architectural asphalt, metal, and designer shingles—installed with precision and built for decades.',
    icon: 'replacement',
    href: '/service/roof-replacement',
  },
  {
    title: 'Maintenance Plan',
    description: 'Annual inspections, moss treatment, and preventative care to extend the life of your roof.',
    icon: 'maintenance',
    href: '/service/maintenance-plan',
  },
  {
    title: 'Damage Repairs',
    description: 'From minor leaks to major damage, we restore your roof\'s integrity using top-tier materials.',
    icon: 'damage',
    href: '/service/damage-repairs',
  },
  {
    title: 'Flashing & Venting',
    description: 'Prevent leaks and extend roof life with professional flashing and venting enhancements.',
    icon: 'flashing',
    href: '/service/flashing-venting',
  },
];

// Icon paths for cleaner template
const icons: Record<string, string> = {
  inspection: 'M21 21l-4.35-4.35M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM11 8v6M8 11h6',
  repair: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
  replacement: 'M3 9l9-7 9 7M5 9v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M9 21v-6h6v6',
  maintenance: 'M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83',
  damage: 'M19.69 14a6.9 6.9 0 0 0 .31-2V5l-8-3-8 3v7c0 6 8 10 8 10s2.97-1.49 5.38-4',
  flashing: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
};
---

<section class="services section section--cream">
  <div class="container services__inner">
    <div class="services__sidebar animate-on-scroll fade-up">
      <h2 class="services__title">Roofing services done to last.</h2>
      <p class="services__intro">
        We serve homeowners and landlords within 60 miles of Vancouver, WA—delivering precise installs, clean sites, and transparent pricing.
      </p>
      <a href="/services" class="btn btn--primary">View All Services</a>
    </div>

    <div class="services__grid stagger-children">
      {services.map((service) => (
        <a href={service.href} class="service-card animate-on-scroll fade-up">
          <div class="service-card__icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={icons[service.icon]} />
            </svg>
          </div>
          <h3 class="service-card__title">{service.title}</h3>
          <p class="service-card__description">{service.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services__inner {
    display: grid;
    grid-template-columns: 1fr 1.8fr;
    gap: var(--space-16);
    align-items: start;
  }

  .services__sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-8));
  }

  .services__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4rem;
    font-weight: 700;
    color: #434338;
    line-height: 1.08;
    margin-bottom: var(--space-8);
  }

  .services__intro {
    color: #5a5a50;
    font-size: 1.125rem;
    line-height: 1.7;
    margin-bottom: var(--space-10);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12) var(--space-16);
  }

  .service-card {
    padding: var(--space-6);
    text-decoration: none;
    display: block;
    border-radius: var(--radius-lg);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .service-card:hover {
    background-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }

  .service-card__icon {
    width: 48px;
    height: 48px;
    margin-bottom: var(--space-5);
    color: #c56125;
  }

  .service-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .service-card__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    color: #434338;
    margin-bottom: var(--space-3);
    transition: color 0.2s ease;
  }

  .service-card:hover .service-card__title {
    color: #c56125;
  }

  .service-card__description {
    font-size: 1.0625rem;
    color: #5a5a50;
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .services__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }

    .services__sidebar {
      position: static;
    }

    .services__title {
      font-size: 2.75rem;
    }
  }

  @media (max-width: 768px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .services__title {
      font-size: 2.25rem;
    }
  }
</style>
