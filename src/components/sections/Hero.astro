---
import { getImage } from 'astro:assets';
import heroBg from '../../assets/images/hero-roof.png';
import { reviews } from '../../data/business';

const optimizedBg = await getImage({ src: heroBg, format: 'webp', quality: 80, width: 1920 });

const ratingLabel = reviews.ratingValue.toFixed(1);
---

<section class="hero" style={`--hero-bg: url('${optimizedBg.src}')`}>
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 class="hero__title hero-animate hero-animate--1">Roofing Service<br>in Vancouver.</h1>
      <p class="hero__text hero-animate hero-animate--2">
        Everstead Roofing keeps your home <strong>safe, dry, and energy-efficient</strong> with premium roofing solutions built for durability.
      </p>
      <div class="hero__buttons hero-animate hero-animate--3">
        <a href="/contact" class="btn btn--primary hero__btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Book A Free Consultation
        </a>
        <a href="/contact" class="btn btn--outline-light hero__btn-secondary">
          Explore Our Services
        </a>
      </div>

      <div class="hero__social-proof hero-animate hero-animate--4">
        <div class="hero__rating">
          <svg class="hero__rating-google" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47a5.53 5.53 0 0 1-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A11.99 11.99 0 0 0 12 24z"/>
            <path fill="#FBBC05" d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58V6.62H1.29a12 12 0 0 0 0 10.76l3.98-3.09z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z"/>
          </svg>

          <div class="hero__rating-detail">
            <div class="hero__rating-top">
              <span class="hero__rating-score">{ratingLabel}</span>
              <span class="hero__rating-stars" role="img" aria-label={`${ratingLabel} out of 5 stars`}>
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                ))}
              </span>
            </div>
            {reviews.profileUrl ? (
              <a class="hero__rating-text hero__rating-text--link" href={reviews.profileUrl} target="_blank" rel="noopener">
                Rated by {reviews.reviewCount}+ Google reviews
              </a>
            ) : (
              <span class="hero__rating-text">Rated by {reviews.reviewCount}+ Google reviews</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
  }

  /* Gradient overlay for text readability */
  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(220, 220, 210, 0.97) 0%,
      rgba(220, 220, 210, 0.9) 60%,
      rgba(220, 220, 210, 0) 100%
    );
    z-index: 1;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-12);
  }

  .hero__content {
    max-width: 680px;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: var(--font-bold);
    line-height: 1.05;
    color: var(--color-navy);
    margin-bottom: var(--space-8);
  }

  .hero__text {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-10);
    max-width: 560px;
    line-height: 1.7;
  }

  .hero__text strong {
    color: var(--color-navy);
    font-weight: var(--font-semibold);
  }

  .hero__buttons {
    display: flex;
    gap: var(--space-5);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .hero__btn-primary {
    padding: var(--space-5) var(--space-10);
    font-size: 1.0625rem;
    gap: var(--space-3);
  }

  .hero__btn-secondary {
    padding: var(--space-5) var(--space-10);
    font-size: 1.0625rem;
    background-color: rgba(255, 255, 255, 0.8);
    border-color: var(--color-gray-300);
    color: var(--color-navy);
  }

  .hero__btn-secondary:hover {
    background-color: var(--color-white);
    border-color: var(--color-navy);
  }

  .hero__social-proof {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(21, 37, 54, 0.08);
    border-radius: var(--radius-full);
    box-shadow: 0 2px 12px rgba(21, 37, 54, 0.08);
  }

  .hero__rating-google {
    flex-shrink: 0;
  }

  .hero__rating-detail {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__rating-top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__rating-score {
    font-size: 1.25rem;
    font-weight: var(--font-bold);
    color: var(--color-navy);
    line-height: 1;
  }

  .hero__rating-stars {
    display: inline-flex;
    gap: 1px;
    color: #f59e0b;
    line-height: 0;
  }

  .hero__rating-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .hero__rating-text--link {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .hero__rating-text--link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero::before {
      width: 100%;
      background: linear-gradient(
        to bottom,
        rgba(220, 220, 210, 0.95) 0%,
        rgba(220, 220, 210, 0.85) 70%,
        rgba(220, 220, 210, 0.7) 100%
      );
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-20) 0;
    }

    .hero__title {
      font-size: 2.5rem;
    }

    .hero__text {
      font-size: 1.125rem;
    }

    .hero__buttons {
      flex-direction: column;
    }

    .hero__btn-primary,
    .hero__btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .hero__rating {
      padding: var(--space-2) var(--space-4);
      gap: var(--space-2);
    }

    .hero__rating-score {
      font-size: 1.125rem;
    }

    .hero__rating-text {
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: 2rem;
    }

    .hero__text {
      font-size: 1rem;
    }

    .hero__btn-primary,
    .hero__btn-secondary {
      padding: var(--space-4) var(--space-6);
      font-size: 1rem;
    }
  }

  /* Hero entrance animations */
  .hero-animate {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 0.8s ease forwards;
  }

  .hero-animate--1 { animation-delay: 0.1s; }
  .hero-animate--2 { animation-delay: 0.25s; }
  .hero-animate--3 { animation-delay: 0.4s; }
  .hero-animate--4 { animation-delay: 0.55s; }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-animate {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
