---
import { Image } from 'astro:assets';
import promise1 from '../../assets/images/promise-1.jpg';
import promise2 from '../../assets/images/promise-2.jpg';
import promise3 from '../../assets/images/promise-3.jpg';

// Our Promise section
const promises = [
  {
    number: 1,
    title: 'Transparent Pricing',
    description: 'Fair, itemized quotes. No pressure, no gimmicks — just clear numbers you can trust.',
  },
  {
    number: 2,
    title: 'Quality Material',
    description: 'Architectural asphalt, metal, and designer shingles from trusted brands, installed to last.',
  },
  {
    number: 3,
    title: 'Dependable Warranty',
    description: '25-year lifetime warranty on new roofs, backed by fast, local support whenever you need it.',
  },
];
---

<section class="promise section">
  <div class="container promise__inner">
    <div class="promise__gallery animate-on-scroll slide-left">
      <div class="promise__img promise__img--main">
        <Image src={promise1} alt="Modern A-frame home with metal roof installation by Everstead Roofing" width={480} height={300} quality={80} format="webp" />
      </div>
      <div class="promise__bottom-row">
        <div class="promise__img promise__img--bottom-left">
          <Image src={promise2} alt="Aerial view of residential roof replacement in Southwest Washington" width={321} height={404} quality={80} format="webp" />
        </div>
        <div class="promise__img promise__img--bottom-right">
          <Image src={promise3} alt="Commercial flat roof installation services Vancouver WA" width={294} height={290} quality={80} format="webp" />
        </div>
      </div>
      <div class="promise__badge">
        <span class="promise__badge-number">9+</span>
        <span class="promise__badge-text">Years of<br>Experience</span>
      </div>
    </div>

    <div class="promise__content animate-on-scroll slide-right">
      <h2 class="promise__title">Our promise: roofs done right, every time</h2>
      <p class="promise__text">
        For over 9 years, Everstead Roofing Co. has served homeowners across Southwest Washington. We believe in clear estimates, meticulous installs, and spotless cleanup — so you can feel confident your home is protected for decades to come.
      </p>

      <div class="promise__points">
        {promises.map((point) => (
          <div class="promise__point">
            <span class="promise__number">{point.number}</span>
            <div>
              <strong class="promise__point-title">{point.title}</strong>
              <p class="promise__point-desc">{point.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .promise__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  /* Gallery - flex column layout matching original */
  .promise__gallery {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
    align-items: flex-start;
  }

  .promise__img {
    overflow: hidden;
    border-radius: 8px;
  }

  .promise__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Top image - smaller, left edge stays in place */
  .promise__img--main {
    margin-left: 36px;
  }

  .promise__img--main img {
    width: 480px;
    height: 300px;
    border-radius: 8px;
  }

  /* Bottom row container */
  .promise__bottom-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  /* Bottom-left - taller */
  .promise__img--bottom-left img {
    width: 321px;
    height: 404px;
    border-radius: 8px;
  }

  /* Bottom-right - shorter */
  .promise__img--bottom-right img {
    width: 294px;
    height: 290px;
    border-radius: 8px;
  }

  /* Badge - square, centered at junction of image corners */
  .promise__badge {
    position: absolute;
    top: 320px;
    left: 350px;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 180px;
    padding: 20px;
    background-color: rgb(173, 173, 159);
    border: 4px solid var(--color-primary);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .promise__badge-number {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4rem;
    font-weight: 700;
    color: #152536;
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .promise__badge-text {
    font-size: 1.125rem;
    color: #152536;
    line-height: 1.4;
    text-align: center;
  }

  /* Content */
  .promise__title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 4rem;
    font-weight: 700;
    color: #434338;
    line-height: 1.1;
    margin-bottom: var(--space-6);
  }

  .promise__text {
    color: #5a5a50;
    margin-bottom: var(--space-10);
    font-size: 1.25rem;
    line-height: 1.7;
  }

  .promise__points {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 480px;
  }

  .promise__point {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .promise__number {
    width: 64px;
    height: 64px;
    background-color: rgb(173, 173, 159);
    border: 2px solid var(--color-primary);
    color: #152536;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 700;
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .promise__point-title {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #434338;
    margin-bottom: var(--space-2);
  }

  .promise__point-desc {
    font-size: 1.125rem;
    color: #5a5a50;
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .promise__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .promise__gallery {
      order: -1;
      max-width: 600px;
      margin: 0 auto;
    }

    .promise__img--main {
      margin-left: 0;
    }

    .promise__img--main img {
      width: 100%;
      height: 250px;
    }

    .promise__bottom-row {
      gap: 16px;
    }

    .promise__img--bottom-left img {
      width: 100%;
      height: 300px;
    }

    .promise__img--bottom-right img {
      width: 100%;
      height: 220px;
    }

    .promise__badge {
      top: 260px;
      left: 50%;
      width: 150px;
      height: 150px;
    }

    .promise__badge-number {
      font-size: 3rem;
    }

    .promise__title {
      font-size: 2.75rem;
    }

    .promise__points {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .promise__gallery {
      gap: 16px;
    }

    .promise__img--main img {
      height: 200px;
    }

    .promise__bottom-row {
      flex-direction: column;
      gap: 16px;
    }

    .promise__img--bottom-left img,
    .promise__img--bottom-right img {
      width: 100%;
      height: 200px;
    }

    .promise__badge {
      top: 210px;
      left: 50%;
      width: 130px;
      height: 130px;
      padding: 16px;
    }

    .promise__badge-number {
      font-size: 2.5rem;
    }

    .promise__badge-text {
      font-size: 0.875rem;
    }

    .promise__title {
      font-size: 2.25rem;
    }

    .promise__number {
      width: 50px;
      height: 50px;
      font-size: 1.5rem;
    }

    .promise__point-title {
      font-size: 1.25rem;
    }

    .promise__point-desc {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .promise__badge {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      margin: -40px auto var(--space-6);
    }
  }
</style>
