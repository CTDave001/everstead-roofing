---
import { Image } from 'astro:assets';
import aboutHeroImg from '../../assets/images/about-hero.jpg';
---

<section class="about-hero">
  <div class="container about-hero__inner">
    <div class="about-hero__content animate-on-scroll slide-right">
      <h1 class="about-hero__title">Everstead<br>Story</h1>
      <p class="about-hero__text">
        We are a local roofing company servicing SW Washington and the greater Portland metro area. With over 9 years of experience, we bring value to the customer and value the local relationships that we have worked hard to build in the community.
      </p>
    </div>
    <div class="about-hero__image animate-on-scroll slide-left">
      <Image src={aboutHeroImg} alt="Aerial view of residential roof installation in Vancouver WA" width={600} height={600} quality={80} format="webp" />
      <div class="about-hero__badge animate-on-scroll scale-in">
        <span class="about-hero__badge-number">9+</span>
        <span class="about-hero__badge-text">Years of<br>Experience</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero {
    background-color: var(--color-white);
    padding: calc(var(--header-height) + var(--space-16)) 0 var(--space-16);
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: var(--space-12);
    align-items: center;
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 6vw, 5rem);
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.05;
    margin-bottom: var(--space-6);
  }

  .about-hero__text {
    font-size: 1.0625rem;
    color: #5a5a50;
    line-height: 1.7;
    max-width: 540px;
  }

  .about-hero__image {
    position: relative;
  }

  .about-hero__image img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .about-hero__badge {
    position: absolute;
    bottom: -30px;
    left: -20px;
    background-color: #e5e5db;
    color: var(--color-navy);
    padding: var(--space-6) var(--space-10);
    border-radius: var(--radius-lg);
    border: 4px solid var(--color-primary);
    text-align: center;
    min-width: 180px;
  }

  .about-hero__badge-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .about-hero__badge-text {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 1024px) {
    .about-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      padding: calc(var(--header-height) + var(--space-10)) 0 var(--space-12);
    }

    .about-hero__image img {
      height: 350px;
    }

    .about-hero__badge {
      left: 0;
    }
  }

  @media (max-width: 480px) {
    .about-hero__image img {
      height: 300px;
    }

    .about-hero__badge {
      padding: var(--space-5) var(--space-8);
      min-width: 140px;
      bottom: -25px;
      left: 0;
    }

    .about-hero__badge-number {
      font-size: 3rem;
    }

    .about-hero__badge-text {
      font-size: 1rem;
    }
  }
</style>
